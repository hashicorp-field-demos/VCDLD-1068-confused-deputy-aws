# Copy this file to terraform.tfvars and customize the values

# General
resource_prefix = "ai"  # Will be combined with 3-char random suffix
aws_region      = "us-east-1"

# HCP Configuration
hcp_client_id     = "<hcp-client-id>"
hcp_client_secret = "<hcp-client-secret>"

# DocumentDB Configuration
docdb_master_username    = "docdbadmin"
docdb_master_password    = "ChangeMe123!"  # Change this to a secure password
docdb_instance_class     = "db.t3.medium"
docdb_instance_count     = 1

# Bastion Host Configuration  
bastion_instance_type = "t3.medium"

# ========================================
# Keycloak Authentication Configuration
# ========================================

# Keycloak Server Configuration
keycloak_url            = "http://localhost:8080"  # Change to your Keycloak URL for production
keycloak_admin_username = "admin"                  # Keycloak admin username
keycloak_admin_password = "admin"                  # Change for production!

# Test User Password
user_password = "password"  # Password for alice and bob test users (change for production!)
